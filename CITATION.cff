    family-names: Chick
    affiliation: "Salk Institute for Biological Studies"
    email: bchick@salk.edu
repository-code: "https://github.com/bchick/timecourse-patterns"
license: MIT
version: 0.1.0
date-released: "2026-09-22"
keywords:
  - bioinformatics
  - ATAC-seq
  - RNA-seq
  - timecourse
  - trajectory clustering
  - chromatin accessibility
  - Snakemake
references:
